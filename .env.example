# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=production
APP_DOMAIN=akshar.sathvikdevops.site

# ── Database ───────────────────────────────────────────────────────────────────
POSTGRES_DB=education
POSTGRES_USER=education
POSTGRES_PASSWORD=replace-with-strong-password
DATABASE_URL=postgresql://education:replace-with-strong-password@postgres:5432/education

# ── Backend ────────────────────────────────────────────────────────────────────
PORT=4000
LOG_LEVEL=info
CORS_ORIGIN=https://akshar.sathvikdevops.site

# ── Cookies ────────────────────────────────────────────────────────────────────
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=akshar.sathvikdevops.site

# ── Session & Authentication ──────────────────────────────────────────────────
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_COOKIE_NAME=akshar_session
SESSION_TTL_HOURS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

# ── Seed Credentials ──────────────────────────────────────────────────────────
SEED_SCHOOL_NAME=Akshar International School
SEED_SCHOOL_CODE=AKSHAR01
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=replace-with-strong-password
SEED_ADMIN_EMAIL=admin@akshar.sathvikdevops.site

# ── AWS / S3 Audio Assets ──────────────────────────────────────────────────────
# The EC2 instance IAM role must have s3:GetObject on the audio prefix.
# Do NOT add AWS_ACCESS_KEY_ID or AWS_SECRET_ACCESS_KEY here — use IAM roles.
AWS_REGION=us-east-1
S3_ASSETS_BUCKET=
S3_AUDIO_PREFIX=audio/
S3_SIGNED_URL_TTL_SECONDS=900

# ── Offline Azure Speech (voice-tools only — not used by the backend) ──────────
# Used only by voice-tools/scripts for offline audio generation.
# Never read by the Fastify backend at runtime.
TTS_PROVIDER=azure
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia

# ── Let's Encrypt / Certbot ───────────────────────────────────────────────────
LETSENCRYPT_EMAIL=
LETSENCRYPT_STAGING=false

# ── Gemini / Assessment AI ────────────────────────────────────────────────────
AI_ENABLED=true
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-flash
GEMINI_API_KEY=your-key-here
AI_TIMEOUT_MS=10000

# ── pgAdmin (optional — docker compose --profile tools up -d pgadmin) ─────────
PGADMIN_EMAIL=admin@akshar.sathvikdevops.site
PGADMIN_PASSWORD=replace-with-strong-password

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:redispassword@redis:6379/0
REDIS_PASSWORD=redispassword

# ── Notifications (Email/SMS) ──────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM_EMAIL=noreply@akshar.sathvikdevops.site
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=+1234567890
